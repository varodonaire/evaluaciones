<<echo=FALSE, results=hide>>=
# -----------------------------
# inecuaciones_1.Rnw
# ax + b > c  con solución x > r (entera)
# -----------------------------
set.seed(sample(1:1e6, 1))

a <- sample(2:6, 1)                 # coeficiente positivo (evita invertir desigualdad)
r <- sample(-6:10, 1)               # umbral entero
b <- sample(-10:10, 1)
c <- a * r + b                      # asegura (c - b)/a = r exacto

# Respuesta correcta en LaTeX
corr_tex <- paste0("\\(x > ", r, "\\)")

# Distractores plausibles
distr_pool <- unique(c(
  paste0("\\(x \\ge ", r, "\\)"),     # confunde > con >=
  paste0("\\(x < ", r, "\\)"),        # invierte sentido
  paste0("\\(x > ", r + 1, "\\)"),    # desplaza umbral
  paste0("\\(x > ", r - 1, "\\)")     # desplaza umbral
))

# Elegir 3 distractores
distractors <- sample(setdiff(distr_pool, corr_tex), 3)

# Construcción de alternativas (4 mezcladas + "Ninguna...")
respuestas <- c(corr_tex, distractors)
respuestas <- sample(respuestas)
respuestas <- c(respuestas, "Ninguna de las anteriores.")

bitstring <- paste0(ifelse(respuestas == corr_tex, 1, 0), collapse = "")
@

\begin{question}
Resuelve la inecuación:
\[
\Sexpr{a}x + \Sexpr{b} > \Sexpr{c}.
\]

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@
\end{question}

%% META-INFORMATION
%% \extype{schoice}
%% \exsolution{\Sexpr{bitstring}}
%% \exname{inecuaciones_1}