<<echo=FALSE, results=hide>>=
#
# ------------------------------------------------------------------
# Ítem 17 – Igualar dos planes lineales   P = m x + b
# Se asegura a > c  →   cruce único y positivo.
# Cada distractor captura un bug concreto (M5–M7).
# ------------------------------------------------------------------

# === Bucle hasta obtener cuatro opciones distintas ===============
repeat {
  # ---------------- Parámetros aleatorios -------------------------
  s <- sample(seq(5, 20, 5), 1)      # solución correcta (nº de películas)
  a <- sample(seq(8, 12), 1)         # pendiente plan A
  b <- sample(seq(2, 5), 1)          # base plan A  (×100 en enunciado)
  c <- sample(seq(3, 6), 1)          # pendiente plan B  (c < a)
  d <- a * s - c * s + b             # base plan B calculada

  # ---------- Respuesta correcta ----------
  correcta <- paste0(s, " películas")

  # ---------- Distractores diagnósticos ----------
  distractor_slopeA <- paste0(a, " películas")                      # M5
  distractor_slopeB <- paste0(c, " películas")                      # M6
  distractor_bad_div <- paste0(round((d - b) / a, 0), " películas") # M7

  opciones <- c(correcta,
                distractor_slopeA,
                distractor_slopeB,
                distractor_bad_div)

  # Salimos del bucle sólo si las 4 opciones son distintas
  if (length(unique(opciones)) == 4) break
}

# ---------- Vector barajado de respuestas ----------
respuestas <- sample(opciones)
respuestas <- c(respuestas, "Ninguna de las anteriores.")

# ---------- Bitstring para exsolution (exactamente un '1') ----------
bitstring <- paste0(ifelse(respuestas == correcta, 1, 0), collapse = "")
@

\begin{question}
Miguel y Valeria están suscritos a distintas plataformas de streaming, cuyos planes de cobro mensual se describen mediante las siguientes expresiones:

\begin{itemize}
    \item Plataforma A: \(\num{\Sexpr{b*100}} + \num{\Sexpr{a*100}} x\)
    \item Plataforma B: \(\num{\Sexpr{d*100}} + \num{\Sexpr{c*100}} x\)
\end{itemize}

donde \(x\) representa la cantidad de películas arrendadas en el mes.

Si ambos pagaron exactamente lo mismo en un mes, ¿cuántas películas arrendó cada uno?

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@

\end{question}


