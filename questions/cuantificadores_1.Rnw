<<echo=FALSE, results=hide>>=
# -----------------------------
# cuantificadores_1.Rnw
# Traducción: "Existe un curso que todos aprobaron"
# -----------------------------
set.seed(sample(1:1e6, 1))

# Sinónimos para variar léxico (manteniendo gramática sencilla)
people_pl <- sample(c("estudiantes", "alumnos", "participantes", "postulantes"), 1)
course_pl <- sample(c("cursos", "talleres", "módulos", "laboratorios"), 1)
course_sg <- switch(course_pl,
  "cursos" = "curso",
  "talleres" = "taller",
  "módulos" = "módulo",
  "laboratorios" = "laboratorio"
)

# Enunciado lógico base: A(x,y) = "x aprobó y"
# Correcta: ∃y ∀x A(x,y)
corr_tex <- "\\(\\exists y\\,\\forall x\\; A(x,y)\\)"

# Distractores plausibles (cuantificadores intercambiados)
distr_pool <- c(
  "\\(\\forall x\\,\\exists y\\; A(x,y)\\)",  # cada estudiante aprobó algún curso
  "\\(\\forall y\\,\\exists x\\; A(x,y)\\)",  # cada curso fue aprobado por alguien
  "\\(\\exists x\\,\\forall y\\; A(x,y)\\)"   # existe un estudiante que aprobó todos los cursos
)

# Construcción de alternativas
respuestas <- c(corr_tex, sample(distr_pool, 3))
ord <- sample(4)
respuestas <- respuestas[ord]
respuestas <- c(respuestas, "Ninguna de las anteriores.")

bitstring <- paste0(ifelse(respuestas == corr_tex, 1, 0), collapse = "")
@

\begin{question}
Sea \(A(x,y)\) la proposición “\(x\) aprobó \(y\)”, donde \(x\) recorre los \Sexpr{people_pl}
y \(y\) recorre los \Sexpr{course_pl}.\\
¿Cuál fórmula representa correctamente la proposición:
“Existe un \Sexpr{course_sg} que todos los \Sexpr{people_pl} aprobaron”?

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@
\end{question}

%% META-INFORMATION
%% \extype{schoice}
%% \exsolution{\Sexpr{bitstring}}
%% \exname{cuantificadores_1}