<<echo=FALSE, results=hide>>=
# -----------------------------
# conjuntos_4.Rnw (Inclusion-Exclusion con múltiplos)
# -----------------------------
set.seed(sample(1:1e6, 1))

# Parámetros aleatorios controlados
N <- sample(45:90, 1)               # tamaño del universo
m <- sample(2:5, 1)
k <- sample(setdiff(3:7, m), 1)     # distinto de m

# Funciones gcd / lcm
gcd_fun <- function(a, b) if (b == 0) a else Recall(b, a %% b)
lcm_fun <- function(a, b) a * b / gcd_fun(a, b)

L <- lcm_fun(m, k)

# Conteos por inclusión-exclusión en U = {1,...,N}
a_count <- N %/% m
b_count <- N %/% k
inter   <- N %/% L
corr_val <- a_count + b_count - inter   # |A ∪ B|

# Distractores plausibles
distr_pool <- unique(c(
  a_count + b_count,        # ignora el solapamiento
  inter,                    # confunde con |A ∩ B|
  a_count,                  # solo |A|
  b_count,                  # solo |B|
  a_count + b_count - 2*inter # resta dos veces la intersección
))

# Filtrar iguales al correcto y valores fuera de rango
distr_pool <- distr_pool[distr_pool != corr_val & distr_pool >= 0 & distr_pool <= N]

# Asegurar 3 distractores
if (length(distr_pool) < 3) {
  extras <- setdiff(0:N, c(corr_val, distr_pool))
  distr_pool <- c(distr_pool, sample(extras, 3 - length(distr_pool)))
}

distractors <- sample(distr_pool, 3)

# Construcción de alternativas
respuestas <- c(as.character(corr_val), as.character(distractors))
ord <- sample(length(respuestas))
respuestas <- respuestas[ord]
respuestas <- c(respuestas, "Ninguna de las anteriores.")

bitstring <- paste0(ifelse(respuestas == as.character(corr_val), 1, 0), collapse = "")
@

\begin{question}
Sea \(U = \{1,2,\dots,\Sexpr{N}\}\).
Define \(A\) como el conjunto de múltiplos de \(\Sexpr{m}\) en \(U\) y \(B\) como el conjunto de múltiplos de \(\Sexpr{k}\) en \(U\).
¿Cuántos elementos tiene \(A \cup B\)?

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@
\end{question}

