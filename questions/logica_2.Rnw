<<echo=FALSE, results=hide>>=
# Banco de tautologías (siempre verdaderas)
taut <- c(
  "$p \\lor \\lnot p$",             # Tercero excluido
  "$p \\leftrightarrow p$",           # Identidad
  "$(p \\land q) \\rightarrow p$",  # Simplificación
  "$p \\rightarrow (q \\rightarrow p)$"
)

# Banco de no-tautologías (contradicciones o contingencias)
nontaut <- c(
  "$p \\land \\lnot p$",     # contradicción
  "$p \\rightarrow \\lnot p$", 
  "$p \\land q$",
  "$\\lnot (p \\lor q)$",
  "$p \\leftrightarrow \\lnot p$"
)

# Selección aleatoria de una tautología correcta
corr <- sample(taut, 1)

# Selección de 3 distractores
respuestas <- c(corr, sample(nontaut, 3))

# Mezclar las cuatro primeras alternativas
ord <- sample(length(respuestas))
respuestas <- respuestas[ord]

# Fijar "Ninguna de las anteriores." al final
respuestas <- c(respuestas, "Ninguna de las anteriores.")

# Bitstring con la correcta en 1 y el resto 0
bitstring <- paste0(ifelse(respuestas == corr, 1, 0), collapse = "")
@

\begin{question}
¿Qué proposición es siempre verdadera?

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@
\end{question}


