<<echo=FALSE, results=hide>>=
# ------------------------------------------------------------------
# Ítem 18 – Puntos de fidelidad
# Cada distractor diagnostica un error concreto (M7, M8, M9).
# ------------------------------------------------------------------

repeat {
  # ---------------- Parámetros aleatorios -------------------------
  pp             <- sample(seq(150, 250, 50), 1)       # puntos por compra
  purchases_done <- sample(2:4, 1)                     # compras ya realizadas
  target_purch   <- sample(purchases_done + 3:6, 1)    # compras totales deseadas

  pts_existing   <- pp * purchases_done                # puntos actuales
  pts_target     <- pp * target_purch                  # puntos meta

  # ---------- Respuesta correcta ----------
  correcta <- target_purch - purchases_done            # compras faltantes

  # ---------- Distractores diagnósticos ----------
  distractor_no_sub      <- target_purch                               # M7
  distractor_minus_1000  <- max(round((pts_target - 1000) / pp, 0), 1) # M8
  distractor_minus_1     <- max(target_purch - 1, 1)                   # M9

  opciones <- c(correcta,
                distractor_no_sub,
                distractor_minus_1000,
                distractor_minus_1)

  # Salir del bucle sólo si todas las opciones son distintas
  if (length(unique(opciones)) == 4) break
}

# ---------- Vector barajado de respuestas ----------
respuestas <- sample(opciones)
respuestas <- c(respuestas, "Ninguna de las anteriores.")

# ---------- Bitstring para exsolution (exactamente un '1') ----------
bitstring <- paste0(ifelse(respuestas == correcta, 1, 0), collapse = "")
@

\begin{question}
Ya has acumulado \num{\Sexpr{pts_existing}} puntos de fidelidad gracias a \Sexpr{purchases_done} compras previas.  
Cada nueva compra suma \num{\Sexpr{pp}} puntos.  
¿Cuántas compras adicionales debes realizar para alcanzar un total de \num{\Sexpr{pts_target}} puntos y canjear tu premio?

<<echo=FALSE, results=tex>>=
answerlist(respuestas, markup = "latex")
@

\end{question}
