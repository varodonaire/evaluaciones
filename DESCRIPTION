    tibble,
    tidyselect,
    stringr,
    readr,
    jsonlite,
    readxl,
    writexl,
    exams
Suggests:
    quarto,
    testthat (>= 3.0.0),
    withr,
    knitr
Config/roxygen2/version: 8.0.0
